  },
  "dependencies": {
    "@zk-email/helpers": "^6.4.2",
    "@zk-email/sdk": "^2.0.11",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=20" }
}

# --- Public (browser) ---
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_DSRP_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Server only. Never prefix these with NEXT_PUBLIC_. ---
# Relayer key: pays gas for walletless guardians. Holds no protocol authority —
# its compromise costs money, never control of a wallet.
RELAYER_PRIVATE_KEY=
RELAYER_RPC_URL=http://127.0.0.1:8545

# Deployments this relayer will pay gas for. REQUIRED in production: the route
# takes contractAddress from the request body, so without an allowlist anyone can
# point the relayer at a contract of their own that burns the block gas limit.
# Unset in production means every request is refused (fail closed). In development
# it falls back to NEXT_PUBLIC_DSRP_ADDRESS.
RELAYER_ALLOWED_CONTRACTS=

# Spend limits. Defaults shown; all optional.
RELAYER_MAX_GAS=1500000          # refuse any transaction estimating above this
RELAYER_MAX_FEE_GWEI=50          # do not bid into a fee spike
RELAYER_MIN_BALANCE_ETH=0.01     # never spend below this reserve
RELAYER_BUDGET_ETH=0.1           # rolling 24h worst-case spend cap
RELAYER_MAX_PER_MINUTE=5         # per-caller rate limit

# Lit Chipotle (v3)
LIT_API_KEY=
LIT_PKP_ID=
LIT_GATE_ACTION_CID=
LIT_API_BASE_URL=https://api.chipotle.litprotocol.com/core/v1
